{block content}

<div class="page-hero">
	<div>
		<h1>Admin Dashboard</h1>
		<p>Manage user privileges and roles.</p>
	</div>
</div>

<div class="page-card">
	<h2 style="margin-bottom: 1.5rem;">User Management</h2>

	{if !$users}
		<div class="text-muted">Žádní uživatelé nejsou v systému.</div>
	{else}
		<div class="table-responsive">
			<table class="table">
				<thead>
					<tr>
						<th>Username</th>
						<th>Current Role</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					{* Changed $user to $u to avoid overwriting conflicts *}
					{foreach $users as $u}
						{var $currentRole = null}
						{foreach $roles as $role}
							{if $role->id === $u['role_id']}
								{var $currentRole = $role}
							{/if}
						{/foreach}
						<tr>
							<td>
								<strong>{$u['username']}</strong>
								<div class="meta" style="margin-top: 0.25rem;">Joined {$u['created_at']|date:'F j, Y'}</div>
							</td>
							<td>
								{if $currentRole}
									<span class="badge bg-primary" style="background-color: var(--warm-orange) !important; color: var(--text-dark) !important;">{$currentRole->name|capitalize}</span>
								{/if}
							</td>
							<td>
								<div class="d-flex gap-2">
									<select class="form-select form-select-sm" style="max-width: 150px;" onchange="updateRole({$u['id']}, this.value)">
										<option value="">Change role...</option>
										{foreach $roles as $role}
											<option value="{$role->id}" {if $role->id === $u['role_id']}selected{/if}>{$role->name|capitalize}</option>
										{/foreach}
									</select>
								</div>
							</td>
						</tr>
					{/foreach}
				</tbody>
			</table>
		</div>
	{/if}
</div>

<style>
	.table {
		background-color: transparent;
		border-collapse: collapse;
		width: 100%;
	}

	.table thead {
		border-bottom: 2px solid var(--warm-beige);
	}

	.table th {
		font-family: 'Courier New', Courier, monospace;
		text-transform: uppercase;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--warm-brown);
		padding: 1rem;
		text-align: left;
	}

	.table td {
		padding: 1rem;
		border-bottom: 1px solid var(--warm-beige);
		color: var(--text-dark);
	}

	.table tbody tr:hover {
		background-color: var(--soft-cream);
	}

	.form-select-sm {
		font-size: 0.875rem;
		padding: 0.375rem 0.75rem;
	}
</style>

<script>
	function updateRole(userId, roleId) {
		if (roleId) {
			window.location.href = '?do=updateRole&userId=' + userId + '&roleId=' + roleId;
		}
	}
</script>

{/block}