{block content}

<div class="page-hero">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1>Combat Air News</h1>
            <p>Latest squadron updates, flight operations, and tactical discussions from the flight line. Login to post reports or join the mission briefing.</p>
        </div>
        {if $authService->canCreatePost($user)}
            <a class="btn btn-primary" n:href="Edit:create">Create Post</a>
        {/if}
    </div>
</div>

{if !$posts}
    <div class="page-card">
        <h2>No Active Missions</h2>
        <p>Currently no active flight reports. Login to submit the first mission briefing.</p>
    </div>
{/if}

<div class="posts-list">
    <div n:foreach="$posts as $post" class="post">
    <a n:href="Post:show $post->id" class='post-link'>
        <h2>{$post->title}</h2>
        <div class="excerpt">{$post->content|truncate:220}</div>
        <div class="meta">Publikováno {$post->created_at|date:'F j, Y'}</div>
    </a>
    </div>
</div>

{/block}
