<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<title>{ifset title}{include title|stripHtml} | {/ifset}Test project</title>
	<link rel="stylesheet" href="{$basePath}/css/style.css">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

	<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body>
	<div class="container py-4">
		<div n:foreach="$flashes as $flash" n:class="alert, 'alert-' . $flash->type">{$flash->message}</div>
		{block navbar}
			<nav class="navbar navbar-expand-sm navbar-dark mb-4 bg-dark">
				<div class="container-fluid">
					<a class="navbar-brand d-flex align-items-center" n:href="Homepage:default">
						<img src="{$basePath}/favicon.ico" alt="Logo" class="me-2">
						<span>Combat Air News</span>
					</a>
					<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
						<span class="navbar-toggler-icon"></span>
					</button>
					<div class="collapse navbar-collapse" id="collapsibleNavbar">
						<ul class="navbar-nav me-auto mb-2 mb-lg-0">
							{if isset($authService) && $authService->canCreatePost($user)}
								<li class="nav-item">
									<a n:href="Edit:create" class="nav-link">New post</a>
								</li>
							{/if}
						</ul>
						<ul class="navbar-nav ms-auto mb-2 mb-lg-0">
							{if $user->isLoggedIn()}
								{if isset($authService)}
									{if $authService->isAdmin($user)}
										<li class="nav-item">
											<a n:href="Admin:default" class="nav-link">Admin</a>
										</li>
									{/if}
									<li class="nav-item bg-warning rounded px-2 ">
										<a href="#" class="nav-link">{$user->getIdentity()->username}</a>
									</li>
								{/if}
								<li class="nav-item"><a n:href="Login:out" class="nav-link">Log Out</a></li>
							{else}
								<li class="nav-item"><a n:href="Login:in" class="nav-link">Sign In</a></li>
								<li class="nav-item"><a n:href="Register:in" class="nav-link">Register</a></li>
							{/if}
						</ul>
					</div>
				</div>
			</nav>
		{/block}

		{include content}
	</div>

	{block scripts}
	<script src="https://nette.github.io/resources/js/3/netteForms.min.js"></script>
	{/block}
</body>
</html>
